compatibility_level = 3.6
myhostname = mail.lab.test
mydomain = lab.test
myorigin = lab.test
mydestination = lab.test, mail.lab.test, localhost
inet_interfaces = all
inet_protocols = all
mynetworks = 127.0.0.0/8 10.0.0.0/8 172.31.0.0/16 [::1]/128 [fd00::]/8
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
home_mailbox = Maildir/
message_size_limit = 20480000
mailbox_size_limit = 0
smtpd_tls_cert_file = /etc/lab/tls/cert.pem
smtpd_tls_key_file = /etc/lab/tls/key.pem
smtpd_tls_security_level = may
smtp_dns_support_level = disabled
disable_dns_lookups = yes
maillog_file = /var/log/postfix.log
