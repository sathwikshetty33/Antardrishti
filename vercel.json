{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m app.api.verify_bundle && cd app/web && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "app/api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{app/web/**,app/docs/**,app/tests/**,analyzer/tests/**,dataset/**,lab/**,capture/**,gen/**,tools/**,features/**,models/**,public/**,**/node_modules/**,**/__pycache__/**,docker-compose.yml}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
