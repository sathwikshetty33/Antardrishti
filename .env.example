# antardrishti platform settings (app/api/settings.py). copy to .env for local runs.
# on vercel, set these in the project's dashboard (Settings > Environment Variables):
# never commit real values and never paste them into chat or issues.

# postgres. local: the docker compose database. vercel: neon's pooled string
# (DATABASE_URL, set by the neon marketplace integration). migrations use
# DATABASE_URL_UNPOOLED (neon's direct string) when it is set.
DATABASE_URL=postgresql://antar:antar@localhost:5434/antar
# DATABASE_URL_UNPOOLED=

# storage for uploaded captures: blob (vercel blob) or local (a folder, local runs only).
# default: blob when BLOB_READ_WRITE_TOKEN is set, else local.
STORAGE=local
# vercel blob read-write token (set by the blob store connection). the api signs browser
# client-upload tokens with it and reads private blobs with it.
# BLOB_READ_WRITE_TOKEN=
# private (default) or public: must match the blob store's access setting
BLOB_ACCESS=private
LOCAL_STORAGE_DIR=.local-storage

# the model bundle directory (relative to the repository root). v2 replaces v1 here, no code change.
MODEL_BUNDLE=app/api/models/v1

# largest upload per file, in MB (the browser uploads straight to blob, so vercel's 4.5 MB
# body limit does not apply)
UPLOAD_LIMIT_MB=100
# largest capture an analysis accepts, uncompressed MB: measured to finish well under vercel
# hobby's 300 s limit on 1 vcpu and 2 gb (app/CLAUDE.md section 12)
MAX_PCAP_MB=300

# optional: an access key needed to upload and start analyses (header x-access-key; the ui
# asks for it once). strongly recommended on a public deployment. unset: open (local).
# APP_ACCESS_KEY=

# scratch space for downloaded captures (vercel functions can write only to /tmp)
TMP_DIR=/tmp
